APP_NAME="Farrux shop (Hozoosp) API"
APP_ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=

# Admin password for browser Basic Auth (change in production!)
ADMIN_PASSWORD=change-me

# URLs
FRONTEND_URL=https://your-frontend.onrender.com
ADMIN_URL=https://your-admin.onrender.com
WEBAPP_URL=https://your-frontend.onrender.com
PUBLIC_API_URL=https://your-backend.onrender.com
CORS_ORIGINS=https://your-frontend.onrender.com,https://your-admin.onrender.com

# Dev only: allows admin access without Telegram outside production
ADMIN_DEV_BYPASS=false

# Uploads / reminders
MAX_UPLOAD_MB=5
CART_REMINDER_DELAY_MINUTES=60

# ---------- Farrux Shop QR Premium ----------
# Permanent QR token. DO NOT CHANGE after labels are printed.
QR_TOKEN=farrux

# Public HTTPS backend URL where /qr lives (same as PUBLIC_API_URL on Render).
QR_PUBLIC_BASE_URL=https://your-backend.onrender.com

# Optional: override final Telegram redirect URL without reprinting QR.
# If empty, backend builds: https://t.me/<TELEGRAM_BOT_USERNAME>?startapp=qr_<QR_TOKEN>
QR_TELEGRAM_URL=

# Bot username without @. If empty, backend resolves it via getMe (BOT_TOKEN required).
TELEGRAM_BOT_USERNAME=

# How many days QR attribution remains valid after Mini App open.
QR_ATTRIBUTION_DAYS=30

# Default label sizes (mm) for generated print PDFs.
QR_HANGTAG_WIDTH_MM=50
QR_HANGTAG_HEIGHT_MM=80
QR_STICKER_WIDTH_MM=50
QR_STICKER_HEIGHT_MM=50
QR_LABEL_MARGIN_MM=3

# ---------- Farrux Currency ----------
CURRENCY_ENABLED=true
CURRENCY_PROVIDER=wasyt
CURRENCY_API_BASE_URL=https://api.wasyt.uz
CURRENCY_REFRESH_MINUTES=15
CURRENCY_REQUEST_TIMEOUT=15
CURRENCY_MANUAL_REFRESH_SECONDS=60
