APP_NAME=Uy Textile API
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://uytextile_user:CHANGE_THIS_PASSWORD@localhost:5432/uytextile

BOT_TOKEN=
ADMIN_TELEGRAM_ID=

FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Публичный HTTPS-адрес витрины для кнопки Mini App в боте.
